---
import "swiper/css"; /* importamos los estilos de swiper */
import "swiper/css/pagination"; /* estilos de paginacion */

/* interface de las props */
interface Props {
  images: string[];
}

const { images } = Astro.props; /* imagenes recibidas por el props */

/* mapeamos el array de imagnes si empieza con http lo devolvemos como esta */
/* sino preparamos la url  */
const fullImages = images.map((image) => {
  return image.startsWith("http")
    ? image
    : `${import.meta.env.PUBLIC_URL}/images/products/${image}`;
});

console.log(fullImages);
---

<!-- Slider main container -->
<div class="swiper mt-10 col-span-1 sm:col-span-2">
  <!-- Additional required wrapper -->
  <div class="swiper-wrapper">
    <!-- Slides -->
    {
      fullImages.map((image) => (
        <div class="swiper-slide">
          <img
            src={image}
            alt="Product image"
            class="w-full h-full object-cover px-10"
          />
        </div>
      ))
    }
  </div>
  <!-- If we need pagination -->
  <div class="swiper-pagination"></div>
</div>

<style>
  .swiper {
    width: 100%;
    height: 600px;
  }
</style>

<script>
  import Swiper from "swiper";
  import { Pagination } from "swiper/modules";

  document.addEventListener("astro:page-load", () => {
    const swiper = new Swiper(".swiper", {
      // Optional parameters
      direction: "horizontal",
      /*   loop: true, */

      // If we need pagination
      pagination: {
        el: ".swiper-pagination",
      },
      modules: [Pagination],
    });
  });
</script>
