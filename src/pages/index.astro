---
import MainLayout from '@/layouts/MainLayout.astro';
import { getSession } from 'auth-astro/server';

const session = await getSession(Astro.request); /* extraemos la sesion que viaja en la request  */

const {user} = session ?? {} /* si existe un usuario en session o sino sera un objeto vacio */

---

<MainLayout>
  <h1 class="text-3xl">Home Page</h1>
  <pre>
    <code>
      {JSON.stringify(user)}
    </code>
  </pre>
</MainLayout>
