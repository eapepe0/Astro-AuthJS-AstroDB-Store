---
import ProductImage from "@/components/products/ProductImage.astro";
import ProductSlideshow from "@/components/products/ProductSlideshow.astro";
import MainLayout from "@/layouts/MainLayout.astro";
import { actions } from "astro:actions";

const { slug } = Astro.params; // obtenemos el slug de los parametros

const { data, error } = await Astro.callAction(
  actions.getProductBySlug,
  slug ?? ""
); // de la accion getProductBySlug obtenemos los datos del producto

// si hay un error vamos a 404
if (error) {
  return Astro.redirect("/404");
}

// desestructuramos de data
const { product, images } = data;


---

<MainLayout title="Mantenimiento de producto">
  <h1>{product.title}</h1>
  <a href="javascript:history.back()" class="text-blue-500">← Volver</a>

  <form class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <input type="hidden" name="id" id="" value={product.id}>
    <!-- Datos generales -->
    <div class="mt-2">
      <h2 class="text-lg font-semibold">Datos generales</h2>

      <!-- Titulo -->
      <div class="mb-4">
        <label for="title" class="block">Título</label>
        <input
          type="text"
          id="title"
          name="title"
          value={product.title}
          class="w-full p-2 border border-gray-300 rounded"
        />
      </div>

      <!-- Slug -->
      <div class="mb-4">
        <label for="slug" class="block">Slug</label>
        <input
          type="text"
          id="slug"
          name="slug"
          value={product.slug}
          class="w-full p-2 border border-gray-300 rounded"
        />
      </div>

      <!-- Descripción -->
      <div class="mb-4">
        <label for="description" class="block">Descripción</label>
        <textarea
          id="description"
          name="description"
          class="w-full p-2 border border-gray-300 rounded"
          rows="8">{product.description}</textarea
        >
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <!-- Precio -->
        <div class="mb-4">
          <label for="price" class="block">Precio</label>
          <input
            type="number"
            id="price"
            name="price"
            value={product.price}
            class="w-full p-2 border border-gray-300 rounded"
          />
        </div>

        <!-- Inventario -->
        <div class="mb-4">
          <label for="stock" class="block">Inventario</label>
          <input
            type="number"
            id="stock"
            name="stock"
            value={product.stock}
            class="w-full p-2 border border-gray-300 rounded"
          />
        </div>
      </div>

      <!-- Labels -->
      <div class="mb-4">
        <label for="tags" class="block"
          >Etiquetas <small class="text-gray-500">(Separado por comas)</small
          ></label
        >
        <input
          type="text"
          id="tags"
          name="tags"
          value={product.tags}
          class="w-full p-2 border border-gray-300 rounded"
        />
      </div>

      <div class="grid grid-cols-2 gap-4">
        <!-- Gender -->
        <div class="mb-4">
          <label for="gender" class="block">Sexo</label>
          <select
            class="w-full p-2 border border-gray-300 rounded"
            name="gender"
          >
            <option value="">[ Seleccione ]</option>
            {
              ["men", "women", "unisex", "kid"].map((gender) => (
                <option
                  value={gender}
                  class="capitalize"
                  selected={gender === product.gender}
                >
                  {gender.toUpperCase()}
                </option>
              ))
            }
          </select>
        </div>

        <!-- Type -->
        <div class="mb-4">
          <label for="tags" class="block">Tipo</label>
          <select class="w-full p-2 border border-gray-300 rounded" name="type">
            <option value="">[ Seleccione ]</option>
            {
              ["shirts", "shirt", "pants", "hats", "hoodies"].map((type) => (
                <option
                  value={type}
                  class="capitalize"
                  selected={type === product.type}
                >
                  {type.toUpperCase()}
                </option>
              ))
            }
          </select>
        </div>
      </div>

      <!-- Tallas -->
      <div class="mb-4">
        <label for="sizes" class="block">Tallas</label>
        <div class="flex">
          {
            ["XS", "S", "M", "L", "XL", "XXL"].map((size) => (
              <button
                type="button"
                class="btn-size"
                onclick="this.classList.toggle('active')"
                class:list={
                    product.sizes.split(',').includes(size) ? 'active' : ''
                }
              >
                {size}
              </button>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Imagenes -->
    <div>
      <!-- File upload -->
      <div class="mt-4">
        <!-- Guardar  -->
        <div class="flex justify-end">
          <button class="bg-blue-500 mb-5 p-2 rounded text-white"
            >Guardar producto</button
          >
        </div>

        <!-- File input -->
        <div class="flex items-center justify-center w-full">
          <label
            for="file-upload"
            class="flex flex-col items-center justify-center w-full h-52 border-2 border-dashed border-gray-300 rounded-lg cursor-pointer hover:bg-gray-100"
            id="drop-zone"
          >
            <div class="flex flex-col items-center justify-center pt-5 pb-6">
              <svg
                class="w-8 h-8 mb-4 text-gray-500"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M7 16V4a2 2 0 012-2h6a2 2 0 012 2v12m-6 4l-4-4m0 0l4-4m-4 4h12"
                ></path>
              </svg>
              <p class="mb-2 text-sm text-gray-500" id="lbl-selected-files">
                <span class="font-semibold">Click aquí </span> o arrastra los archivos
              </p>
              <p class="text-xs text-gray-500">
                SVG, PNG, JPG or GIF (max. 800x400px)
              </p>
            </div>

            <!-- class="hidden" -->
            <!-- accept only images -->
            <input
              id="file-upload"
              name="imageFiles"
              type="file"
              accept="image/*"
              multiple
            />
          </label>
        </div>

        <!-- Slideshow -->
        <ProductSlideshow images={images.map(i =>  i.image)} />

        <table class="w-full border">
          <thead>
            <tr>
              <th>Imagen</th>
              <th>Eliminar</th>
            </tr>
          </thead>
          <tbody>
            {
              images.map(({image,id}) => (
                <tr class="border" id={id}>
                  <td class="flex justify-center">
                    <ProductImage
                      src={image}
                      alt={product.title}
                      className="w-16 h-16 rounded"
                    />
                  </td>
                  <td class="text-center">
                    <button type="button" class="btn-delete-image" data-id={id}>X</button>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </form>

  <style>
    .btn-size,
    .btn-delete-image {
      @apply rounded border cursor-pointer border-gray-300 w-10 h-10 mr-4 hover:bg-blue-300 hover:text-white transition-all;
    }

    .active {
      @apply bg-blue-500 text-white;
    }
  </style>
</MainLayout>


<script>
  import { actions } from 'astro:actions';
  import { navigate } from 'astro:transitions/client';

  /* cubrimos con el astro:page-load por el ViewTransitions aka ClientRouter */
  document.addEventListener('astro:page-load', () => {
    const form = document.querySelector('form') as HTMLFormElement;  /* buscamos el form */
    const sizeButtons = document.querySelectorAll('.btn-size'); /* seleccionamos todo lo que tenga la clase .btn-size */
    const btnsDeleteImage = document.querySelectorAll<HTMLButtonElement>('.btn-delete-image'); // seleccionamos los botones X de cerrar
    
    /* hacemos esta validacion por si el ViewTransitions tira error si no existe el form en alguna transicion */
    if (!form) {
      return;
    }

    /* Si apretamos Guardar Producto */

    form.addEventListener('submit', async (e) => {
      e.preventDefault();  // prevenimos la recarga de la pantalla

      const selectedSizes = Array.from(sizeButtons) // convertimos el objeto sizeButtons a un array
        .filter((btn) => btn.classList.contains('active')) // nos quedamos con los que contienen active
        .map((btn) => btn.textContent?.trim()) // tomamos cada texto de esos botones , le sacamos el espacio en blanco
        .join(','); // los juntamos con una coma

      const formData = new FormData(form); // crea un objeto FormData, que crea un par de llaves y valores para que sea mas facil enviar en un request
      formData.set('sizes', selectedSizes);

      const formValues = Object.fromEntries(formData.entries()); // creamos un objeto con las entradas y mostramos el valor

      const { data, error } = await actions.createUpdateProduct(formData);

      if (error) {
        return alert(error.message);
      }

      navigate(`/admin/products/${data.slug}`);
    });

    // Eliminar imagenes
    // por cada boton de borrar
    btnsDeleteImage.forEach((btn) => {
      // le agregamos un evento click a cada boton
      btn.addEventListener('click', async (e) => {
        const id = btn.dataset.id; // extraemos el id del data-set
        if (!id) return; //  si no existe el data-set retornamos

        const { error } = await actions.deleteProductImage(id); // accion que borra la imagen de la db y de cloudinary en caso de que corresponda (la url empieza con http)
        //  si devuelve un error lo mostramos y retornamos
        if (error) {
          console.log(error);
          alert(error);
          return;
        }
        

        const trId = `#${id}`; // al id alfanumerico le agregamos un # para convertirlo en id
        document.getElementById(id)?.remove(); // buscamos el elemento con el id el cual es un table row (<TR>)y lo removemos del DOM

        /* navigate() */
      });
    });

    // Drag & Drop
    const lblSelectedFiles = document.querySelector('#lbl-selected-files') as HTMLParagraphElement; // seleccionamos el label de cantidad de archivos 
    const dropZone = document.querySelector('#drop-zone') as HTMLLabelElement; // seleccionamos el dropzone
    const fileInput = document.querySelector('#file-upload') as HTMLInputElement; // seleccionamos el input de file-upload


    // funcion que previene por defecto los comportamiento de distintos eventos drag
    const preventDefaults = (e: DragEvent) => {
      e.preventDefault();
      e.stopPropagation();
    };

    // funcion que cambia el borde y el fondo a el dropzone agregandole una clase
    const highlight = (e: DragEvent) => {
      dropZone.classList.add('border-blue-500', 'bg-blue-50');
    };
    // funcion que cambia el borde y el fondo a el dropzone sacandole una clase
    const unHighlight = (e: DragEvent) => {
      dropZone.classList.remove('border-blue-500', 'bg-blue-50');
    };

    /**
    * Convierte un array de Files en un FileList
    * @param  array de Files , del tipo File por ejemplo => File ,lastModified : 1759260363990 ,lastModifiedDate:  Tue Sep 30 2025, name: "5172490077794839162_121-BKZMWjMF.jpg",size: 187604 ,type: "image/jpeg"
    * @returns  Retorna un objeto DataTransfer de FileList, es el contenedor de datos que viaja durante operaciones de arrastrar y soltar (Drag & Drop) o en el portapapeles.
    * @example
    *    createFileList(file) // 
    */
    const createFileList = (files: File[]): FileList => {
      const dataTrasfer = new DataTransfer(); // creamos un objeto DataTransfer
      files.forEach((file) => dataTrasfer.items.add(file)); // agregamos cada archivo enviado como parametro al objeto
      return dataTrasfer.files;
    };


    /**
    * Funcion que maneja los archivos enviados al dropzone , filtra y hace el conteo de archivos
    * @param files : ["1.jpg","2.jpg"]
    * @returns  No retorna nada.
    * @example
    *    Ejemplo de uso y en lo posible que retorna ej: sum(2, 3) // 5
    */
    
    const handleFiles = (files: FileList) => { // recibimos un FileList
      // filtramos los archivos para ver si son validos , si empieza el type con la palabra 'image/'
      const validFiles = Array.from(files).filter((file) =>
        file.type.startsWith('image/')
      );

      // si existe el fileInput  y hay archivos validos
      if (fileInput && validFiles.length > 0) {
        fileInput.files = createFileList(validFiles); // le enviamos al fileInput el array de  files , pero hay que prepararlos para que sea un fileList
      }

      lblSelectedFiles.innerHTML = `<strong>${validFiles.length} archivos seleccionados</strong>`;
    };

    // prevenimos los comportamientos por defecto del dragenter , dragover , dragleave , drop
    (['dragenter', 'dragover', 'dragleave', 'drop'] as const).forEach(
      (eventName) => {
        dropZone.addEventListener(eventName, preventDefaults);
        document.body.addEventListener(eventName, preventDefaults);
      }
    );
    
    // si hacemos dragenter o dragover le agregamos un eventlistener y le ponemos la funcion de cambio de fondo
    (['dragenter', 'dragover'] as const).forEach((eventName) => {
      dropZone.addEventListener(eventName, highlight);
    });
    // si hacemos dragenter o dragover le agregamos un eventlistener y le ponemos la funcion de cambio de fondo
    (['dragleave', 'drop'] as const).forEach((eventName) => {
      dropZone.addEventListener(eventName, unHighlight);
    });

    // Sólo imágenes
    // le agregamos un eventListener de drop a la dropzone
    dropZone.addEventListener('drop', (e) => {
      const files = e.dataTransfer?.files; // en e.dataTransfer estan los archivos

      // si existen archivos
      if (files) {
        handleFiles(files); // llamamos a la funcion que los maneja
      }
    });

    // fin del astro:load
  });
</script>

