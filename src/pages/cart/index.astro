---
import MainLayout from "@/layouts/MainLayout.astro";
import { actions } from "astro:actions";
import {Formatter} from '@/utils/formatter'

const { data : products, error} = await Astro.callAction(actions.loadProductsFromCart,{});

/* si existe error o no existe productos volvemos */
if(error || !products) {
    return Astro.redirect('/')
}

/* sumamos el total del carrito , sumamos el acumulado con la multiplicacion del precio por la cantidad , arranca en 0 */
const total = products?.reduce((acc, producto)=> acc + producto.price * producto.quantity , 0)

---

<MainLayout title="Carrito de compras">
    <h1 class="mb-10">Carrito</h1>
    <section class="grid grid-cols-1 sm:grid-cols-2">

      {
        products.length > 0 ? (
          <!-- Productos -->
        <div class="order-2 sm:order-1">
          <div class="mb-10">
            <h2>Productos</h2>
            <a href="javascript:history.back()" class="hover:underline text-blue-500">Regresar</a>
          </div>
            {
                products?.map(producto => (
                    <div class="flex gap-5 mt-5">
                        <img src={producto.image} alt={producto.title} class="w-20 h-20"/>
                        <div class="">
                            <a href={`/products/${producto.slug}`} class="hover:underline">{producto.title}</a>
                            <p>${producto.price}</p>
                            <p>
                                Talla : <span class="font-bold">{producto.size}</span>
                            </p>
                            <p>
                                Cantidad : <span class="font-bold">{producto.quantity}</span>
                            </p>
                            <button class="text-blue-500 btn-delete" data-id={producto.productId} data-size={producto.size}>
                                Remover
                            </button>
                        </div>
                    </div>
                ))
            }
        </div>


        <!-- Totales -->

      <div class="bg-black h-[330px] text-white p-6 rounded-lg shadow-lg order-1">
      <h2 class="text-lg font-semibold mb-4">Resumen de compra</h2>

      <div class="flex justify-between text-gray-400 mb-2">
        <span>Envío</span>
        <span>Gratis</span>
      </div>

      <div class="flex justify-between text-gray-400 mb-4">
        <span>SubTotal </span>
        <span>{Formatter.currency(total)}</span>
      </div>
      <div class="flex justify-between text-gray-400 mb-4">
        <span>Impuesto </span>
        <span>{Formatter.currency(total * 0.15)}</span>
      </div>

      <div class="flex justify-between text-xl font-bold">
        <span>Total</span>
        <span>{Formatter.currency(total * 1.15)}</span>
      </div>

      <button
        class="mt-10 w-full bg-blue-700 text-gray-300 py-3 rounded-lg hover:bg-gray-600 transition-all"
      >
        PAGAR
      </button>
    </div>
        )
        : 
   (
  <div class="col-span-1 sm:col-span-2">
    <div class="relative isolate overflow-hidden rounded-2xl border border-dashed border-gray-300 p-10 text-center
                bg-[radial-gradient(120%_80%_at_100%_0%,#e0f2fe_0%,#ffffff_55%)] dark:bg-[radial-gradient(120%_80%_at_100%_0%,#0b1220_0%,#0b1220_55%)]
                shadow-sm">
      <!-- Icono -->
      <div class="mx-auto mb-4 grid h-16 w-16 place-items-center rounded-full bg-white/80 dark:bg-white/10 shadow">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                d="M2.25 3h1.386c.51 0 .955.343 1.09.835l.383 1.437M7.5 14.25h9.75m-12-9h13.036c.64 0 1.108.61.95 1.232l-1.5 6A1.125 1.125 0 0 1 16.65 13.5H8.1a1.125 1.125 0 0 1-1.094-.855L5.25 5.25m2.25 12a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Zm9 0a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Z" />
        </svg>
      </div>

      <!-- Texto -->
      <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100">Tu carrito está vacío</h2>
      <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
        Agregá productos para verlos acá y finalizar tu compra.
      </p>
    </div>
  </div>
)
      }
        
    </section>

</MainLayout>


<script>
import { itemsInCart } from "@/store/cart.store";
import { CartCookiesClient } from "@/utils/cart-cookies";
import { navigate } from "astro:transitions/client";


document.addEventListener('astro:page-load', () => {
    const deleteButtons : NodeListOf<HTMLButtonElement> = document.querySelectorAll('.btn-delete'); // seleccionamos todos los botones remover del carro

        deleteButtons.forEach(button => {
          /* a cada boton remover le agregamos un eventListener */
            button.addEventListener('click', (event)=>{

                const target = event.target as HTMLButtonElement; /* que boton apretamos  */
                const productId = target.dataset.id ?? ''; /* con ese target , seria el boton que apretamos , le sacamos el id del producto */
                const size = target.dataset.size ?? ''; /* con ese target , seria el boton que apretamos , le sacamos el size del producto */
                
               const cart =CartCookiesClient.removeItem(productId , size) /* removemos del carro que estan en las cookies ese producto */
               itemsInCart.set(cart.length)
               navigate('/cart') /* recargamos la pagina  */
            })
        })
})
</script>